---
import Button from "../button.astro";
import resources from "../../collections/resources.json";
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    resources
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    收藏各大镜像资源站
  </p>
  <div
    class="grid items-stretch w-full sm:grid-cols-2 md:grid-cols-5 gap-7 mt-7"
  >
    {resources.map((resource) => (
      <div class="flex items-center justify-center w-full py-1">
        <Button text={resource.name} link={resource.url} />
      </div>
    ))}
  </div>

</section>