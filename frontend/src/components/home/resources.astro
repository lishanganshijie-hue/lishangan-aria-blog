---
// src/components/home/resources.astro
import Button from "../button.astro";
import defaultResources from "../../collections/resources.json"; // 🟢 引入本地死数据作为后备

// 1. 🌐 连接 Render 后端
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://futuristic-blog-api-eh2x.onrender.com/api/v1';
let resources = defaultResources;

try {
  // 🔗 拉取镜像资源数据。可以通过 query 参数过滤出来自管理后台的“友情链接”或“镜像资源”
  const response = await fetch(`${apiUrl}/resources?type=mirror&limit=20`);
  if (response.ok) {
    const data = await response.json();
    const remoteItems = data.items || data;
    if (remoteItems && remoteItems.length > 0) {
      resources = remoteItems;
    }
  }
} catch (error) {
  console.error("❌ Resources 组件拉取云端镜像失败，启用本地后备:", error);
}
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    Resources
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    收藏各大镜像资源站
  </p>
  <div
    class="grid items-stretch w-full sm:grid-cols-2 md:grid-cols-5 gap-7 mt-7"
  >
    {resources.map((resource: any) => (
      <div class="flex items-center justify-center w-full py-1">
        <Button text={resource.name || resource.title} link={resource.url} />
      </div>
    ))}
  </div>
</section>