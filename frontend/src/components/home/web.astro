---
// src/components/home/web.astro
import defaultWeb from "../../collections/web.json"; // 🟢 引入本地死数据作为默认后备
import Button from "../button.astro";
import Project from "../project.astro";

// 1. 🌐 连接 Render 后端
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://futuristic-blog-api-eh2x.onrender.com/api/v1';
let webItems = defaultWeb;

try {
  // 🔗 戳你后端的生态/全量资源接口（根据你 FastAPI 实际路由如 /ecosystem 或 /resources?type=web 调整）
  const response = await fetch(`${apiUrl}/resources?type=web&limit=10`);
  if (response.ok) {
    const data = await response.json();
    
    // 对齐后端常用的 PaginatedResponse 的 items 包裹结构
    const remoteItems = data.items || data;
    
    if (remoteItems && remoteItems.length > 0) {
      webItems = remoteItems;
    }
  }
} catch (error) {
  console.error("❌ Web (Ecosystem) 组件拉取云端数据失败，启用本地 web.json 后备:", error);
}

// 2. ✂️ 保持首页设计：只切出前 3 个生态卡片进行高亮曝光
const displayWeb = webItems.slice(0, 3);
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    My Ecosystem
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    生态系统群
  </p>
  <div
    class="grid items-stretch w-full sm:grid-cols-2 md:grid-cols-3 gap-7 mt-7"
  >
    {
      displayWeb.map((item: any) => {
        return (
          <Project
            name={item.name || item.title} { /* 🛡️ 字段双保险 */ }
            description={item.description || item.summary}
            image={item.image || item.cover_image}
            url={item.url}
          />
        )
      })
    }
  </div>

  <div class="flex items-center justify-center w-full py-5">
    <Button text="查看更多" link="/web" />
  </div>
</section>