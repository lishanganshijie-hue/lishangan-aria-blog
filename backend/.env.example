###############################################################################
# 1. 核心基础与安全配置 (Core & Security)
###############################################################################
# SECRET_KEY: 运行 uvicorn 前随便敲一串长字符。生产环境记得换掉
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30
TIMEZONE=Asia/Shanghai

###############################################################################
# 2. 数据库与缓存中间件 (Databases - Neon & Redis)
###############################################################################
# 🟢 Neon 数据库连接串（直接去 Neon 控制台复制连接串即可，格式如下）
DATABASE_URL=postgresql://alex:your-neon-password@ep-cool-butterfly-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 🟢 Redis 连接串（本地开发起一个 redis-server 即可，若线上用 Upstash 或 ElastiCache 再换链接）
REDIS_URL=redis://localhost:6379/0

###############################################################################
# 3. 超级管理员初始账号 (Seed Admin Account)
###############################################################################
# 系统第一次连接 Neon 数据库时，会自动帮你用以下信息创建后台大号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@yourdomain.com

###############################################################################
# 4. 前后台网络多线对齐 (CORS & Matrix Anti-Cross-Error)
###############################################################################
# 🛰️ 核心微操：同时允许 Vue3后台(5173端口) 和 Astro前台(4321端口) 跨域调用 FastAPI
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4321"]
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321

# 🧭 后端发送邮件里包含的「找回密码/激活链接」指向 Vue3 后台大本营
FRONTEND_URL=http://localhost:5173

# 🌐 你的博客主站指向 Astro 前台
SITE_URL=http://localhost:4321

###############################################################################
# 5. 对象存储大迁移：从 Supabase 转向 Cloudflare R2 (Object Storage)
###############################################################################
# 🛑 关闭原作者默认的 Supabase 存储
USE_SUPABASE_STORAGE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET=your-bucket-name

# ⚡【Cloudflare R2 模块激活】
# R2 完美兼容 AWS S3 协议，所以在后端代码里，它是通过 S3 的客户端（boto3）去读写的
# 填入你在 Cloudflare 仪表盘「R2」->「Manage R2 API Tokens」里生成的凭证
S3_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key

# 填入你在 Cloudflare 创建的 R2 Bucket 桶名称
S3_BUCKET_NAME=your-r2-bucket-name

# 🔗 Cloudflare R2 专属的 Endpoint 终端节点连接（非常重要，格式如下）
# 可以在 R2 桶的设置页右侧找到，形如：https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# 🌍 读者在前台看你博客图片时使用的加速自定义域名（在 R2 桶里绑定你的域名或使用 R2 自带的 dev 域名）
S3_PUBLIC_URL=https://pub-your-random-id.r2.dev

# 本地上传的临时缓存目录
AVATAR_STORAGE_PATH=/app/uploads

###############################################################################
# 6. 通讯哨兵：邮件发送服务 (Email Notification)
###############################################################################
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# 备用的传统 SMTP 配置（如果不用 Resend，代码里转去读取以下参数）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Futuristic Blog

###############################################################################
# 7. SEO 第三方推送 (SEO & Analytics)
###############################################################################
# 百度搜索主动推送的 Token，暂时没有可以先留空，不影响后台运行
BAIDU_PUSH_TOKEN=